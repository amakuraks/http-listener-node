# ═══ DATABASE ═══
DATABASE_ENGINE=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
# Always quote: an unquoted # truncates the value silently.
DATABASE_PASSWORD=""
DATABASE_NAME=request_tester

# ═══ APP ═══
# HOST is a security control. Loopback only by default: this app has no
# authentication and stores captured credentials in cleartext.
HOST=127.0.0.1
PORT=3000
PAGE_SIZE=20
MAX_BODY_SIZE=50mb
BODY_PREVIEW_CHARS=2000
BODY_INLINE_MAX=131072
